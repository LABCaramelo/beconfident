# Copie para .env.local. Nunca coloque o token administrativo no frontend.
UAZAPI_BASE_URL=https://seu-servidor.uazapi.com
UAZAPI_INSTANCE_TOKEN=
UAZAPI_OWNER_NUMBER=
UAZAPI_WEBHOOK_SECRET=
# Lista explícita de contatos de teste (números internacionais ou JIDs), separados por vírgula.
UAZAPI_ALLOWED_CHATS=
# false: apenas rascunhos locais, sem enviar mensagens.
UAZAPI_SEND_ENABLED=false
UAZAPI_PUBLIC_WEBHOOK_URL=
UAZAPI_WEBHOOK_ID=
SESSION_HASH_SECRET=
ADMIN_API_SECRET=
# Chave somente no backend privado. Não usar prefixo NEXT_PUBLIC_ ou VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Ative somente após validar a chave, o modelo e o teste mínimo de geração.
AI_TUTOR_ENABLED=false
